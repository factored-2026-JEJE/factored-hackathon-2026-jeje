{
  "alvo": "e2e",
  "executor": "playwright-stack",
  "diretorio": "/repo",
  "timeout_s": 300,
  "timeout_stack_s": 600,
  "compose_args": [
    "-f",
    "compose.yaml",
    "-f",
    "compose.ci.yaml",
    "-f",
    "mutantes/compose.mutantes.yaml"
  ],
  "servicos_stack": [
    "web"
  ],
  "comando_teste": [
    "run",
    "--rm",
    "e2e",
    "npx",
    "playwright",
    "test"
  ],
  "comando_coleta": [
    "--profile",
    "e2e",
    "run",
    "--rm",
    "--build",
    "--no-deps",
    "e2e",
    "npx",
    "playwright",
    "test",
    "--list",
    "--reporter=json"
  ],
  "mutantes": [
    {
      "id": "CONTROLE-e2e",
      "espera": "sobrevive",
      "descricao": "Troca sem efeito no comportamento; a jornada precisa continuar verde",
      "trocas": [
        {
          "arquivo": "frontend/Caddyfile",
          "de": "# API_UPSTREAM vem do compose versionado.",
          "para": "# API_UPSTREAM vem do compose versionado (controle)."
        }
      ],
      "testes": [
        "status.spec.ts"
      ]
    },
    {
      "id": "M-E2E-01",
      "requisito": "R06",
      "descricao": "Caminho do proxy digitado errado: /api cai no fallback da SPA e recebe HTML",
      "trocas": [
        {
          "arquivo": "frontend/Caddyfile",
          "de": "\thandle_path /api/* {",
          "para": "\thandle_path /apis/* {"
        }
      ],
      "testes": [
        "status.spec.ts > página de status mostra exatamente o estado que a API reporta"
      ]
    },
    {
      "id": "M-E2E-02",
      "requisito": "R06",
      "descricao": "Compose aponta o proxy para uma porta errada da API (502 para o navegador)",
      "trocas": [
        {
          "arquivo": "compose.yaml",
          "de": "      API_UPSTREAM: api:8000",
          "para": "      API_UPSTREAM: api:9000"
        }
      ],
      "testes": [
        "status.spec.ts > página de status mostra exatamente o estado que a API reporta"
      ]
    },
    {
      "id": "M-E2E-03",
      "requisito": "R04",
      "descricao": "Seed carrega uma seleção de tabelas diferente da configurada (drift de configuração)",
      "trocas": [
        {
          "arquivo": "compose.yaml",
          "de": "      DATASET_TABLES: *dataset-tables\n      DATASET_SOURCE: s3",
          "para": "      DATASET_TABLES: branches,customers,products,service_agents,marketing_campaigns,daily_exchange_rates,transactions,call_center_interactions,call_transcripts,satisfaction_surveys,complaints\n      DATASET_SOURCE: s3"
        }
      ],
      "testes": [
        "dados.spec.ts > stack sobe pronta com exatamente a versão de dados do manifesto versionado"
      ]
    },
    {
      "id": "M-E2E-04",
      "requisito": "R06",
      "descricao": "Página exibe a versão truncada em 8 caracteres",
      "trocas": [
        {
          "arquivo": "frontend/src/StatusDoSistema.tsx",
          "de": "dataset.version.slice(0, 12)",
          "para": "dataset.version.slice(0, 8)"
        }
      ],
      "testes": [
        "dados.spec.ts > stack sobe pronta com exatamente a versão de dados do manifesto versionado"
      ]
    }
  ]
}
