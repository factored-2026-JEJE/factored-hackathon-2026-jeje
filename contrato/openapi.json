{
  "openapi": "3.1.0",
  "info": {
    "title": "JEJE",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "description": "Processo vivo; não consulta dependências.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/dados/qualidade": {
      "get": {
        "summary": "Relatorio De Qualidade",
        "description": "Relatório da última carga, na ordem de dependência dos contratos.",
        "operationId": "relatorio_de_qualidade_dados_qualidade_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QualidadeTabela"
                  },
                  "type": "array",
                  "title": "Response Relatorio De Qualidade Dados Qualidade Get"
                }
              }
            }
          }
        }
      }
    },
    "/dados/eda": {
      "get": {
        "summary": "Indicadores Da Eda",
        "description": "Indicadores da EDA calculados na hora sobre a carga atual, cada um com sua consulta.",
        "operationId": "indicadores_da_eda_dados_eda_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Resultado"
                  },
                  "type": "array",
                  "title": "Response Indicadores Da Eda Dados Eda Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatasetInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "loaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Loaded At"
          }
        },
        "type": "object",
        "required": [
          "version",
          "source",
          "loaded_at"
        ],
        "title": "DatasetInfo"
      },
      "Linha": {
        "properties": {
          "grupo": {
            "type": "string",
            "title": "Grupo"
          },
          "contagem": {
            "type": "integer",
            "title": "Contagem"
          },
          "base": {
            "type": "integer",
            "title": "Base"
          },
          "proporcao": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proporcao"
          },
          "soma": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soma"
          },
          "proporcao_soma": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proporcao Soma"
          }
        },
        "type": "object",
        "required": [
          "grupo",
          "contagem",
          "base",
          "proporcao",
          "soma",
          "proporcao_soma"
        ],
        "title": "Linha"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Liveness"
      },
      "QualidadeTabela": {
        "properties": {
          "tabela": {
            "type": "string",
            "title": "Tabela"
          },
          "raw": {
            "type": "integer",
            "title": "Raw"
          },
          "curado": {
            "type": "integer",
            "title": "Curado"
          },
          "quarentena": {
            "type": "integer",
            "title": "Quarentena"
          },
          "copias_descartadas": {
            "type": "integer",
            "title": "Copias Descartadas"
          },
          "motivos": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Motivos"
          },
          "anulacoes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Anulacoes"
          },
          "normalizacoes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Normalizacoes"
          }
        },
        "type": "object",
        "required": [
          "tabela",
          "raw",
          "curado",
          "quarentena",
          "copias_descartadas",
          "motivos",
          "anulacoes",
          "normalizacoes"
        ],
        "title": "QualidadeTabela"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable",
              "not_migrated"
            ],
            "title": "Database"
          },
          "dataset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatasetInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "dataset"
        ],
        "title": "Readiness"
      },
      "Resultado": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "pergunta": {
            "type": "string",
            "title": "Pergunta"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "distribuicao",
              "taxa"
            ],
            "title": "Tipo"
          },
          "consulta": {
            "type": "string",
            "title": "Consulta"
          },
          "unidade_soma": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unidade Soma"
          },
          "linhas": {
            "items": {
              "$ref": "#/components/schemas/Linha"
            },
            "type": "array",
            "title": "Linhas"
          }
        },
        "type": "object",
        "required": [
          "id",
          "pergunta",
          "tipo",
          "consulta",
          "unidade_soma",
          "linhas"
        ],
        "title": "Resultado"
      }
    }
  }
}
