{
  "openapi": "3.1.0",
  "info": {
    "title": "JEJE",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "description": "Processo vivo; não consulta dependências.",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/dados/qualidade": {
      "get": {
        "summary": "Relatorio De Qualidade",
        "description": "Relatório da última carga, na ordem de dependência dos contratos.",
        "operationId": "relatorio_de_qualidade_dados_qualidade_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QualidadeTabela"
                  },
                  "type": "array",
                  "title": "Response Relatorio De Qualidade Dados Qualidade Get"
                }
              }
            }
          }
        }
      }
    },
    "/dados/eda": {
      "get": {
        "summary": "Indicadores Da Eda",
        "description": "Indicadores da EDA calculados na hora sobre a carga atual, cada um com sua consulta.",
        "operationId": "indicadores_da_eda_dados_eda_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Resultado"
                  },
                  "type": "array",
                  "title": "Response Indicadores Da Eda Dados Eda Get"
                }
              }
            }
          }
        }
      }
    },
    "/personas": {
      "get": {
        "summary": "Listar Personas",
        "description": "Personas de demonstração (acesso de teste explícito, só com MODO_DEMO ligado).",
        "operationId": "listar_personas_personas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Persona"
                  },
                  "type": "array",
                  "title": "Response Listar Personas Personas Get"
                }
              }
            }
          },
          "404": {
            "description": "Modo demo desligado ou persona não provisionada"
          }
        }
      }
    },
    "/sessoes": {
      "post": {
        "summary": "Abrir Sessao",
        "operationId": "abrir_sessao_sessoes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoDeSessao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoAberta"
                }
              }
            }
          },
          "404": {
            "description": "Modo demo desligado ou persona não provisionada"
          },
          "400": {
            "description": "Corpo ilegível (não é JSON UTF-8)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessao": {
      "get": {
        "summary": "Sessao Atual",
        "description": "Quem está na sessão (o nome vem da persona provisionada).",
        "operationId": "sessao_atual_sessao_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Persona"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou expirada"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/minhas/transacoes": {
      "get": {
        "summary": "Minhas Transacoes",
        "operationId": "minhas_transacoes_minhas_transacoes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limite"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Transacao"
                  },
                  "title": "Response Minhas Transacoes Minhas Transacoes Get"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou expirada"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/minhas/transacoes/{transaction_id}": {
      "get": {
        "summary": "Minha Transacao",
        "operationId": "minha_transacao_minhas_transacoes__transaction_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$",
              "title": "Transaction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transacao"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, inválida ou expirada"
          },
          "404": {
            "description": "Transação não encontrada"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatasetInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "loaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Loaded At"
          }
        },
        "type": "object",
        "required": [
          "version",
          "source",
          "loaded_at"
        ],
        "title": "DatasetInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Linha": {
        "properties": {
          "grupo": {
            "type": "string",
            "title": "Grupo"
          },
          "contagem": {
            "type": "integer",
            "title": "Contagem"
          },
          "base": {
            "type": "integer",
            "title": "Base"
          },
          "proporcao": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proporcao"
          },
          "soma": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Soma"
          },
          "proporcao_soma": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proporcao Soma"
          }
        },
        "type": "object",
        "required": [
          "grupo",
          "contagem",
          "base",
          "proporcao",
          "soma",
          "proporcao_soma"
        ],
        "title": "Linha"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Liveness"
      },
      "PedidoDeSessao": {
        "properties": {
          "customer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Customer Id"
          }
        },
        "type": "object",
        "required": [
          "customer_id"
        ],
        "title": "PedidoDeSessao"
      },
      "Persona": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "nome"
        ],
        "title": "Persona"
      },
      "QualidadeTabela": {
        "properties": {
          "tabela": {
            "type": "string",
            "title": "Tabela"
          },
          "raw": {
            "type": "integer",
            "title": "Raw"
          },
          "curado": {
            "type": "integer",
            "title": "Curado"
          },
          "quarentena": {
            "type": "integer",
            "title": "Quarentena"
          },
          "copias_descartadas": {
            "type": "integer",
            "title": "Copias Descartadas"
          },
          "motivos": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Motivos"
          },
          "anulacoes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Anulacoes"
          },
          "normalizacoes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Normalizacoes"
          }
        },
        "type": "object",
        "required": [
          "tabela",
          "raw",
          "curado",
          "quarentena",
          "copias_descartadas",
          "motivos",
          "anulacoes",
          "normalizacoes"
        ],
        "title": "QualidadeTabela"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable",
              "not_migrated"
            ],
            "title": "Database"
          },
          "dataset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatasetInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "dataset"
        ],
        "title": "Readiness"
      },
      "Resultado": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "pergunta": {
            "type": "string",
            "title": "Pergunta"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "distribuicao",
              "taxa"
            ],
            "title": "Tipo"
          },
          "consulta": {
            "type": "string",
            "title": "Consulta"
          },
          "unidade_soma": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unidade Soma"
          },
          "linhas": {
            "items": {
              "$ref": "#/components/schemas/Linha"
            },
            "type": "array",
            "title": "Linhas"
          }
        },
        "type": "object",
        "required": [
          "id",
          "pergunta",
          "tipo",
          "consulta",
          "unidade_soma",
          "linhas"
        ],
        "title": "Resultado"
      },
      "SessaoAberta": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time",
            "title": "Expira Em"
          },
          "cliente": {
            "$ref": "#/components/schemas/Persona"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expira_em",
          "cliente"
        ],
        "title": "SessaoAberta"
      },
      "Transacao": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "transaction_date": {
            "type": "string",
            "format": "date-time",
            "title": "Transaction Date"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "transaction_status": {
            "type": "string",
            "title": "Transaction Status"
          },
          "response_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Code"
          },
          "transaction_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Type"
          },
          "merchant_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Name"
          },
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "transaction_date",
          "amount",
          "currency",
          "transaction_status",
          "response_code",
          "transaction_type",
          "merchant_name",
          "channel"
        ],
        "title": "Transacao"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token da sessão de teste (POST /sessoes)",
        "scheme": "bearer"
      }
    }
  }
}
