# Somente segredos (a configuração não secreta fica no compose.yaml). Nunca versione o .env.
# Valores: página 2 do dicionário do dataset (acesso somente leitura dos organizadores).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATASET_S3_URI=
# Opcional: token do GitHub para as reviews da demo virarem Issue (só com a fixture, ACH-038).
GITHUB_TOKEN=
# Publicação para os jurados (make publicar, PRD-009): a senha que os jurados recebem (16 ou mais
# caracteres) e o token do túnel nomeado do Cloudflare (cloudflared tunnel token jeje).
SENHA_DOS_JURADOS=
CLOUDFLARE_TUNNEL_TOKEN=
# Opcional: senha da demonstração do time pelo túnel (make demo); vazia, a demo abre sem senha.
SENHA_DA_DEMO=
# Opcional: o canal do aviso de que a publicação caiu (scripts/avisar.sh): o endereço de um tópico do
# ntfy ou de um webhook que aceite um POST de texto. Vazio, o aviso fica só no registro da vigia.
AVISO_URL=
