# Servidor web do produto: estáticos do build + proxy /api para o backend (mesma origem, sem CORS).
# API_UPSTREAM vem do compose versionado.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip
	# Toda resposta (página e API): sem adivinhar tipo, sem ser embutida em outro site
	# (clickjacking) e sem vazar o endereço como referer.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy no-referrer
	}
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
