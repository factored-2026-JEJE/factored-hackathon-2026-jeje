# Servidor web do produto: estáticos do build + proxy /api para o backend (mesma origem, sem CORS).
# API_UPSTREAM vem do compose versionado.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip
	# Toda resposta (página e API): sem adivinhar tipo, sem ser embutida em outro site
	# (clickjacking) e sem vazar o endereço como referer. Só a própria origem embute: o site em /site/
	# abre o app de / numa janela (design de 03/10).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy no-referrer
	}
	# Publicação (ACH-115): o Cloudflare diz em X-Forwarded-Proto o esquema em que o visitante
	# chegou. Em http, volta em https (308) antes de qualquer resposta; em https, o HSTS faz o
	# navegador nunca mais mandar a senha dos jurados em http. Sem o cabeçalho (stack local), nada.
	@http header X-Forwarded-Proto http
	redir @http https://{host}{uri} 308
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000"
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	# O site do JEJE (DEV-032a): página própria em /site/, ao lado do app, no mesmo build.
	redir /site /site/ 308
	handle /site/* {
		root * /srv
		try_files {path} /site/index.html
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
